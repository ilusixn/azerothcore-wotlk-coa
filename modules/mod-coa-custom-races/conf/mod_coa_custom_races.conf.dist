[worldserver]

###################################################################################################
# CoA Custom Races
###################################################################################################

#
#    CoACustomRaces.Enable
#        Description: Master switch for the CoA Custom races and their features (races above 11, the Esteria
#                     appearance, racials, start zones, .hidearmor, the free talent reset). Read once at startup.
#        Default:     0 - Disabled, the server behaves like the upstream core
#                     1 - Enabled
#

CoACustomRaces.Enable = 0

#
#    CoACustomRaces.DbcDirectory
#        Description: Directory with the server DBC files of the custom races, relative to DataDir. A DBC found
#                     there replaces the one in DataDir/dbc. Only used when CoACustomRaces.Enable = 1.
#        Default:     "dbc_races"
#

CoACustomRaces.DbcDirectory = "dbc_races"

#
#    CoACustomRaces.BotsEnable
#        Description: Lets random bots (mod-playerbots) get the custom races. 0 = bots only get the base races.
#                     Even with 1, bots never get a race the races list marks botsOk = false or clientCrash = true,
#                     nor one in DisabledRaces, nor a sex the list does not give that race.
#        Default:     0 - Disabled
#                     1 - Enabled
#

CoACustomRaces.BotsEnable = 0

#
#    CoACustomRaces.DisabledRaces
#        Description: Comma-separated race ids that stay unavailable even when CoACustomRaces.Enable = 1
#                     (for example races whose client model still crashes). Empty = none.
#        Default:     ""
#

CoACustomRaces.DisabledRaces = ""

#
#    CoACustomRaces.RacesList
#        Description: Path of races-list.json (the list of the custom races with botsOk, clientCrash, sexes).
#                     Empty = DataDir/../Races/races-list.json, then ../../Races/races-list.json, then
#                     Races/races-list.json. Without the file no custom race is given to bots.
#        Default:     ""
#

CoACustomRaces.RacesList = ""
